[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/AudioSourceStripView.cs" id="1_strip"]

[sub_resource type="StyleBoxFlat" id="MeterBackground"]
bg_color = Color(0.12, 0.12, 0.12, 1)

[sub_resource type="StyleBoxFlat" id="MeterFill"]
bg_color = Color(0.6, 0.75, 0.48, 1)

[node name="AudioSourceStrip" type="HBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1_strip")

[node name="Name" type="Label" parent="."]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 14
text = "Sorgente audio"
text_overrun_behavior = 3

[node name="Level" type="ProgressBar" parent="."]
custom_minimum_size = Vector2(64, 12)
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/background = SubResource("MeterBackground")
theme_override_styles/fill = SubResource("MeterFill")
max_value = 1.0
step = 0.001
show_percentage = false

[node name="Gain" type="HSlider" parent="."]
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Volume di questa sorgente nel mix"
max_value = 200.0
value = 100.0

[node name="GainValue" type="Label" parent="."]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "100%"
horizontal_alignment = 2

[node name="Remove" type="Button" parent="."]
layout_mode = 2
tooltip_text = "Rimuovi questa sorgente dal mix"
text = "×"
