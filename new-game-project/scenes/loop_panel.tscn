[gd_scene load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://icons/record.svg" id="1_record"]
[ext_resource type="Texture2D" path="res://icons/stop.svg" id="2_stop"]
[ext_resource type="Texture2D" path="res://icons/play.svg" id="3_play"]

[node name="LoopPanel" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3
text = "Registra una clip e ripetila insieme alla voce live. Per ascoltare o trasmettere, avvia Mix dal vivo."

[node name="RecordRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Record" type="Button" parent="RecordRow"]
icon = ExtResource("1_record")
layout_mode = 2
custom_minimum_size = Vector2(48, 48)
tooltip_text = "Registra un nuovo loop dalle sorgenti live, con EQ ed echo"

[node name="StopRecord" type="Button" parent="RecordRow"]
icon = ExtResource("2_stop")
layout_mode = 2
custom_minimum_size = Vector2(48, 48)
disabled = true
tooltip_text = "Ferma la registrazione e aggiungi la clip alla lista"

[node name="Elapsed" type="Label" parent="RecordRow"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
text = "00:00.0"

[node name="ListHeader" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="ListHeader"]
layout_mode = 2
size_flags_horizontal = 3
text = "CLIP"

[node name="Count" type="Label" parent="ListHeader"]
layout_mode = 2
text = "0 / 10"

[node name="Clips" type="ItemList" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 180)
size_flags_horizontal = 3
allow_reselect = true

[node name="PlaybackRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Play" type="Button" parent="PlaybackRow"]
icon = ExtResource("3_play")
layout_mode = 2
custom_minimum_size = Vector2(48, 48)
disabled = true
tooltip_text = "Avvia la clip in ripetizione nel mix live"

[node name="Stop" type="Button" parent="PlaybackRow"]
icon = ExtResource("2_stop")
layout_mode = 2
custom_minimum_size = Vector2(48, 48)
disabled = true
tooltip_text = "Ferma il loop; la voce live continua"

[node name="Save" type="Button" parent="PlaybackRow"]
layout_mode = 2
disabled = true
text = "Salva WAV"

[node name="VolumeRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="VolumeRow"]
layout_mode = 2
text = "Volume"

[node name="Volume" type="HSlider" parent="VolumeRow"]
layout_mode = 2
custom_minimum_size = Vector2(60, 24)
size_flags_horizontal = 3
max_value = 200.0
value = 100.0

[node name="Value" type="Label" parent="VolumeRow"]
layout_mode = 2
custom_minimum_size = Vector2(48, 0)
horizontal_alignment = 2
text = "100%"

[node name="PauseRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="PauseRow"]
layout_mode = 2
text = "Pausa"

[node name="Pause" type="SpinBox" parent="PauseRow"]
layout_mode = 2
size_flags_horizontal = 3
max_value = 300.0
step = 0.1
suffix = "s"
tooltip_text = "Attesa tra fine clip e nuova ripartenza. Zero = ripetizione continua."

[node name="PauseHint" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3
text = "La pausa parte dopo la fine della clip. 0 s = loop continuo. Volume e pausa sono separati per ogni clip."

[node name="Status" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3
text = "Registra il primo loop con il pulsante rosso."

[node name="TemporaryHint" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3
text = "Temporanee per questa sessione. Oltre 10 viene rimossa la più vecchia. Salva WAV per conservarla."
